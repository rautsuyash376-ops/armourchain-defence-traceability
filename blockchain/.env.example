# Copy to .env locally. Never commit .env or any real credentials.
# Use a dedicated deployment account; do not use a personal or operational wallet.
PRIVATE_KEY=

# Testnet values supplied by the buildathon guide. The explorer announces that
# this legacy Testnet is scheduled for retirement after 2027-01-31; confirm with MST
# whether the buildathon expects this network or MST Coral Testnet before deploying.
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_TESTNET_TARGET_CONFIRMED=

# Mainnet RPC is intentionally blank until the exact endpoint is confirmed from
# official MST developer documentation/support. Do not put credentials in this value.
MST_MAINNET_RPC_URL=

# Optional explorer API token if MSTScan requires one for source verification.
MSTSCAN_API_KEY=

# Mainnet safeguards; required only when explicitly authorizing a production deployment.
MAINNET_DEPLOYMENT_AUTHORIZATION=
MAINNET_APPROVAL_REFERENCE=
EXPECTED_MAINNET_DEPLOYER_ADDRESS=
MAINNET_MIN_BALANCE_MSTC=

# Set to true only if intentionally replacing a deployment record after a new deployment.
ALLOW_DEPLOYMENT_RECORD_OVERWRITE=false
